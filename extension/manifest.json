{
  "manifest_version": 3,
  "name": "嘉然直播点赞助手",
  "version": "0.1.1",
  "description": "在嘉然直播间经你授权后，自动触发本轮的原生点赞。",
  "minimum_chrome_version": "105",
  "permissions": ["activeTab", "scripting"],
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "嘉然直播点赞助手",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  }
}
